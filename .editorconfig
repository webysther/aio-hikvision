# How the files of the project are written: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# ruff, with the line length of pyproject.toml
[*.py]
indent_size = 4
max_line_length = 110

# Answers of real devices (anonymized): never reformatted, not even their last line
[tests/fakes/fixtures/**]
insert_final_newline = unset
trim_trailing_whitespace = unset
